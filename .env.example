# Copy to .env.local (never commit real values — the repo is public).

# Postgres connection string. On Supabase use Connect → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed to log in.
ALLOWED_EMAILS=you@example.com

# Login by email magic link: 1 (default when unset) or 0 to turn it off.
# Off = the login form is hidden, no link is sent, and links already emailed are rejected.
# Sessions that are already signed in keep working.
MAGIC_LINK_LOGIN=1

# AI provider: anthropic | openai | google (default anthropic).
AI_PROVIDER=anthropic
# Model ids for the two tiers (default claude-sonnet-5-5). Overridable in Settings.
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-sonnet-5-5

# Provider keys — only the one for AI_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# 1 = use mock models answering from tests/fixtures/ai/<task>.json (no key needed).
AI_MOCK=0

# No-login mode (works in production too): every visitor acts as this user id and
# lands on Home without logging in. Use your own Supabase user id to keep your data.
# WARNING: anyone with the URL can then use the app (and your AI key). Remove it to
# require login again.
# NO_LOGIN_USER_ID=00000000-0000-4000-8000-000000000001

# Dev only (ignored when NODE_ENV=production): act as this user id without Supabase login.
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
