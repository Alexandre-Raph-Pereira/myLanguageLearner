# Rendered by scripts/home/install.sh into ~/.config/systemd/user/ (placeholders @...@).
[Unit]
Description=myLanguageLearner (Next.js, home server)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PATH=@PATH@
Environment=NODE_ENV=production
# Next.js loads .env.production.local itself. Bound to 127.0.0.1: only Tailscale Serve
# (same machine) can reach it, nothing on the LAN or the internet.
ExecStart=@PNPM@ start -H 127.0.0.1 -p @PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
